# /etc/tac-advisor.env — read by tac-advisor.service (mode 600, holds the Gemini key).

# LLM backend: auto | openai_compat | gemini | local | template
#   auto = every configured backend in order: LLM_URL server, then Gemini, then the local GGUF model,
#   then the offline template SITREP (no model; always the last resort, so the mesh never gets error text)
LLM_BACKEND=auto

# Network LLM server: Ollama on the HQ Mac, or any OpenAI-compatible server. Bare base URL, no path
# (the advisor adds /v1/chat/completions or /api/chat itself). Empty = not used.
LLM_URL=
# e.g. LLM_URL=http://isr-hq.local:11434
LLM_MODEL=qwen3.5:27b
LLM_TIMEOUT_S=90
# openai = POST /v1/chat/completions; ollama = Ollama native /api/chat (thinking off, faster)
# auto = ollama if the URL is port 11434 or has "ollama" in the host, else openai; falls back to the other
LLM_API=auto
LLM_KEEP_ALIVE=30m
# LLM_API_KEY=   (only for servers that need a Bearer token)

# Optional cloud mode. Without a key everything runs offline on the local GGUF model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=20

# Local model (offline fallback). Put .gguf files here.
ADVISOR_MODELS_DIR=/var/lib/tac-advisor/models
# ADVISOR_MODEL=qwen3-0.6b-q5_k_m.gguf
ADVISOR_N_THREADS=3

# TAK server (OpenTAKServer on this Pi, plain TCP CoT)
TAK_HOST=127.0.0.1
TAK_PORT=8087
ADVISOR_CALLSIGN=TAC-ADVISOR

# meshbus + heartbeat broker (OTS RabbitMQ on the Pi). ADVISOR_NO_MESH=1 disables mesh queries.
# On the Pi keep 127.0.0.1 / guest. Running on a Mac instead: MQTT_HOST=isr-pi.local, TAK_HOST=isr-pi.local,
# MQTT_USER=isrkit and its password (RabbitMQ's guest account only works from the Pi itself).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
# Heartbeat on isrkit/heartbeat/tac-advisor every 10 s (HEARTBEAT=0 disables; PUBLIC_URL overrides the URL)
# ISR_HOST names this station in the heartbeat (default: lowercased short hostname), e.g. isr-hq
ISR_HOST=
HEARTBEAT=1

# Shared OP position (kit contract C4.2), the same in every tool's env file. tac-advisor does not
# draw markers, so it only keeps this for consistency.
SENSOR_LAT=
SENSOR_LON=

WEB_PORT=8090
# Extra arguments, e.g. --simulate, or --serial /dev/ttyUSB0 (standalone only, never with mesh-bridge)
ADVISOR_ARGS=
