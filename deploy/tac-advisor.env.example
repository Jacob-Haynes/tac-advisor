# /etc/tac-advisor.env — read by tac-advisor.service (mode 600, holds the Gemini key).

# LLM backend: auto (Gemini if GEMINI_API_KEY is set, else local) | gemini | local
LLM_BACKEND=auto
# Optional cloud mode. Without a key everything runs offline on the local GGUF model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=20

# Local model (offline fallback). Put .gguf files here.
ADVISOR_MODELS_DIR=/var/lib/tac-advisor/models
# ADVISOR_MODEL=qwen3-0.6b-q5_k_m.gguf
ADVISOR_N_THREADS=3

# TAK server (OpenTAKServer on this Pi, plain TCP CoT)
TAK_HOST=127.0.0.1
TAK_PORT=8087
ADVISOR_CALLSIGN=TAC-ADVISOR

# meshbus broker (OTS RabbitMQ). ADVISOR_NO_MESH=1 disables mesh queries.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest

WEB_PORT=8090
# Extra arguments, e.g. --simulate, or --serial /dev/ttyUSB0 (standalone only, never with mesh-bridge)
ADVISOR_ARGS=
